{
  "name": "desktop",
  "productName": "Social Media Agent",
  "version": "0.1.0",
  "private": true,
  "description": "Plan, draft and schedule Instagram Reels with Codex.",
  "author": "Hashfi",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "stage": "node scripts/stage.mjs",
    "icons": "node scripts/icons.mjs",
    "start": "node scripts/build.mjs && electron .",
    "dist": "node scripts/stage.mjs && node scripts/build.mjs && electron-builder --win --publish never",
    "release": "node scripts/stage.mjs && node scripts/build.mjs && electron-builder --win --publish never && node scripts/publish.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "release:upload": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "@openai/codex": "0.157.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "type": "module"
}
