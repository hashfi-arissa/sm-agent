---
import Layout from "./Layout.astro";

interface Props {
  title: string;
  description: string;
  updated: string;
}

const { title, description, updated } = Astro.props;
---

<Layout title={`${title} — Social Media Agent`} description={description}>
  <main class="mx-auto max-w-2xl px-6 py-16 sm:py-20">
    <h1 class="text-3xl font-semibold tracking-tight">{title}</h1>
    <p class="mt-2 text-sm text-muted-foreground">Last updated {updated}</p>
    <article class="mt-10 flex flex-col gap-4 leading-relaxed [&_a]:underline [&_a]:underline-offset-2 [&_code]:rounded [&_code]:bg-muted [&_code]:px-1 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-sm [&_h2]:mt-6 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_li]:ml-5 [&_li]:list-disc [&_li]:pl-1 [&_p]:text-muted-foreground [&_ul]:flex [&_ul]:flex-col [&_ul]:gap-2 [&_ul]:text-muted-foreground">
      <slot />
    </article>
  </main>
</Layout>
